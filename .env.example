# ---- Agent provider ----
AGENT_PROVIDER=openai_realtime         # openai_realtime | anthropic_11labs | gemini_live
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=                 # optional; blank uses Pipecat's default realtime model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPGRAM_API_KEY=                      # needed for anthropic_11labs (speech-to-text)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_API_KEY=                        # needed for gemini_live

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                     # also used to verify webhook signatures
TWILIO_PHONE_NUMBER=+15555550123

# ---- Agent runtime ----
AGENT_HOST=0.0.0.0
AGENT_PORT=8765
AGENT_PUBLIC_WS_URL=wss://your-agent.fly.dev/stream
LAMBDA_BASE_URL=                       # ApiBaseUrl output from `sam deploy`
TOOL_API_SECRET=                       # same value as TOOL_API_SECRET in Secrets Manager; signs every tool request
# ALLOW_UNSIGNED_TOOL_CALLS=true        # local development only: lets handlers accept unsigned requests
BUSINESS_TIMEZONE=America/New_York     # the agent's sense of "today" and the calendar's local time

# ---- Call limits (src/agent/call_limits.py); 0 turns a limit off ----
CALL_MAX_DURATION_SECONDS=900          # goodbye and hang up after this long
CALL_DURATION_WARNING_SECONDS=60       # tell the caller to wrap up this long before the maximum
CALL_IDLE_PROMPT_SECONDS=15            # caller silent this long: "are you still there?"
CALL_IDLE_TIMEOUT_SECONDS=30           # caller silent this long: goodbye and hang up
CALL_GOODBYE_GRACE_SECONDS=8           # time for the goodbye to be spoken before the call ends

# ---- Post-call summaries ----
CALL_SUMMARY_ENABLED=true
SUMMARY_PROVIDER=auto                  # auto | anthropic | openai | none (auto: whichever key is set)
SUMMARY_MODEL=                         # optional; defaults to claude-haiku-4-5 or gpt-4.1-mini

# ---- Safeguards ----
AUDIT_LOG_PATH=./logs/audit.jsonl
AUDIT_SALT=                            # random string; caller numbers are stored only as salted hashes

# ---- Velocity store (src/safeguards/velocity_redis.py); memory is per process ----
VELOCITY_BACKEND=memory                # memory | redis (redis: limits shared by every voice-process instance)
REDIS_URL=                             # e.g. rediss://:password@your-redis-host:6379/0 when VELOCITY_BACKEND=redis
VELOCITY_REDIS_PREFIX=velocity

# ---- Policy (docs/policy.md): config/policy.yaml is the reviewed source; an invalid file stops the process ----
POLICY_FILE=                           # blank: config/policy.yaml
# The variables below adjust the loaded policy; blank or malformed values keep the file's values.
POLICY_ALLOWED_TOOLS=                  # comma list to narrow the allow-list; blank = every tool with a declared tier
POLICY_MAX_PAYMENT_LINKS_PER_CALL=4    # payment links one call may issue
POLICY_MAX_USD_PER_CALL=5000           # cumulative USD across a call's payment links (first link capped by MAX_PAYMENT_USD)
POLICY_MAX_ACTIONS_PER_CALL=8          # completed state-changing actions per call
POLICY_RISK_THRESHOLD=4                # social-engineering score at which high-tier tools hand off to a person
POLICY_HANDOFF_MIN_TIER=high           # low | medium | high: lowest tool tier that hands off on risk
POLICY_STEP_UP_MIN_TIER=high           # low | medium | high | off: lowest tool tier that needs a verified caller

# ---- Step-up verification (docs/auth.md); without a verifier and a CRM lookup nobody can verify (fail closed) ----
TWILIO_VERIFY_SERVICE_SID=             # VA...: sends and checks one-time codes via Twilio Verify
CRM_LOOKUP_FILE=                       # local dev only: JSON list of {customer_id, phone_on_file, lookup_numbers}
STEP_UP_MAX_FAILED_ATTEMPTS=3          # wrong codes per call before verification locks and hands off
STEP_UP_MAX_SENDS_PER_CALL=3           # codes one call may send
STEP_UP_CODE_TTL_SECONDS=600           # code lifetime
STEP_UP_CHANNELS=sms,call              # channels the agent may use for the code

# ---- AI disclosure and recording consent (docs/compliance.md); set the same values on the webhook Lambdas ----
AI_DISCLOSURE_TEXT=                    # blank: "Hi, you've reached an automated assistant. You're talking with an A.I., not a person."
RECORDING_ENABLED=false                # this repo never records unless this is true
RECORDING_CONSENT_MODE=always          # always | by_jurisdiction | off
RECORDING_ALL_PARTY_STATES=            # blank: CA,CT,DE,FL,IL,MD,MA,MI,MT,NV,NH,OR,PA,WA (conservative; verify with counsel)
BUSINESS_JURISDICTION=                 # e.g. FL: if the business is in an all-party state, ask every caller
# CONSENT_ACTION_URL=                  # override the consent <Gather> action URL (default: the /consent route next to /voice)

# ---- Payments (docs/pci.md) ----
PAYMENT_MODE=link                      # link: text a Stripe Payment Link | keypad: Twilio <Pay> card capture by keypad
# Keypad mode, set on the keypad_payment Lambda (the SAM template does this):
# PAY_ACTION_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod/pay_result
# PAY_CONNECTOR=Default               # Twilio Pay Connector unique name (e.g. a Stripe connector)
# PAY_POSTAL_CODE=false               # ask for the billing postal code

# ---- Observability (docs/observability.md); tracing is off unless an endpoint is set ----
OTEL_EXPORTER_OTLP_ENDPOINT=           # e.g. http://localhost:4318 (Jaeger), http://localhost:6006 (Phoenix)
OTEL_EXPORTER_OTLP_HEADERS=            # e.g. Authorization=Basic%20<base64 key pair> for Langfuse
OTEL_SERVICE_NAME=voice-agent

# ---- Business integrations (local dev; in AWS these come from Secrets Manager) ----
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/gcal-sa.json
STRIPE_SECRET_KEY=
MAX_PAYMENT_USD=5000
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=

LOG_LEVEL=INFO

# ---- Console server (live mode: python -m src.console_server or docker compose up; docs/console.md) ----
# Read from the process environment (the console server does not load .env). Needs none of the keys above:
# tool calls run the real Lambda handler code with faked outside services.
CONSOLE_HOST=127.0.0.1                  # 0.0.0.0 inside the container; compose publishes on localhost only
CONSOLE_PORT=8090
CONSOLE_TOKEN=                          # optional: require this token on /api/* (enter it in the console's Settings)
