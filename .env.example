# ---- Agent provider ----
AGENT_PROVIDER=openai_realtime         # openai_realtime | anthropic_11labs | gemini_live
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=                 # optional; blank uses Pipecat's default realtime model
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPGRAM_API_KEY=                      # needed for anthropic_11labs (speech-to-text)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
GOOGLE_API_KEY=                        # needed for gemini_live

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                     # also used to verify webhook signatures
TWILIO_PHONE_NUMBER=+15555550123

# ---- Agent runtime ----
AGENT_HOST=0.0.0.0
AGENT_PORT=8765
AGENT_PUBLIC_WS_URL=wss://your-agent.fly.dev/stream
LAMBDA_BASE_URL=                       # ApiBaseUrl output from `sam deploy`
BUSINESS_TIMEZONE=America/New_York     # the agent's sense of "today" and the calendar's local time

# ---- Post-call summaries ----
CALL_SUMMARY_ENABLED=true
SUMMARY_PROVIDER=auto                  # auto | anthropic | openai | none (auto: whichever key is set)
SUMMARY_MODEL=                         # optional; defaults to claude-haiku-4-5 or gpt-4.1-mini

# ---- Safeguards ----
AUDIT_LOG_PATH=./logs/audit.jsonl
AUDIT_SALT=                            # random string; caller numbers are stored only as salted hashes

# ---- Business integrations (local dev; in AWS these come from Secrets Manager) ----
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/gcal-sa.json
STRIPE_SECRET_KEY=
MAX_PAYMENT_USD=5000
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_API_TOKEN=
GOHIGHLEVEL_API_KEY=
GOHIGHLEVEL_LOCATION_ID=

LOG_LEVEL=INFO
