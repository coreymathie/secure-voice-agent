# Corey Mathie, 2026
# Console server image (live mode): `docker compose up`, then http://localhost:8090/console/
# Runs the real Lambda handler code in-process behind HMAC-signed requests, with the eval fakes standing in
# for Stripe, Twilio, Google Calendar, Zendesk, the CRM, and DynamoDB. No paid API keys, no phone line.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CONSOLE_HOST=0.0.0.0 \
    CONSOLE_PORT=8090

WORKDIR /app
COPY requirements-console.txt .
RUN pip install --no-cache-dir -r requirements-console.txt

COPY src ./src
COPY config ./config
COPY evals ./evals
COPY demo ./demo

RUN useradd --create-home --uid 10001 console && chown -R console /app
USER console

EXPOSE 8090
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/health', timeout=2)"
CMD ["python", "-m", "src.console_server"]
